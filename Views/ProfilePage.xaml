<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Tarea8_AutenticacionToken.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mi perfil">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="18"
            VerticalOptions="Center">

            <Label
                Text="Mi perfil"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#2563EB"
                HorizontalOptions="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#2563EB" />

            <Border
                Padding="20"
                Stroke="#D1D5DB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15">

                <VerticalStackLayout Spacing="15">

                    <Image
                        Source="{Binding Usuario.Image}"
                        HeightRequest="130"
                        WidthRequest="130"
                        Aspect="AspectFit"
                        HorizontalOptions="Center" />

                    <Label
                        Text="{Binding Usuario.FirstName}"
                        FontSize="23"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <Label
                        Text="{Binding Usuario.LastName}"
                        FontSize="20"
                        HorizontalOptions="Center" />

                    <Label
                        Text="{Binding Usuario.Email}"
                        FontSize="16"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding Mensaje}"
                TextColor="Red"
                HorizontalTextAlignment="Center" />

            <Button
                Text="Cerrar sesión"
                Command="{Binding CerrarSesionCommand}"
                BackgroundColor="#DC2626"
                TextColor="White"
                CornerRadius="10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
